# Copy this file to .env and fill in your own values.
# .env is gitignored and will not be committed.

# PostgreSQL password used by Docker Compose (see docker-compose.yml)
POSTGRES_PASSWORD=changeme

# App host port for Docker Compose (container port 3000)
APP_PORT=3000

# Full connection string consumed by the application
DATABASE_URL=postgresql://opnnotes:changeme@localhost:5432/opnnotes
